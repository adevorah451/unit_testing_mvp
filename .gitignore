.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.coverage

# pipeline run outputs (report.md / metrics.json / pbt artifacts) — reproducible, don't commit
runs/

# post-hoc rescorings of a completed run (reaggregate.py) — reproducible from runs/, don't commit
reaggregations/

# full APPS pools (32-52 MB each), rebuildable with prepare_candidate_pool.py.
# apps_pool_hard10.json and apps_pool_random50.json are kept: they are small and published
# numbers use them. A new pool goes in this list in the diff that creates it.
apps_pool_hard.json
apps_pool_heldout40.json
apps_pool_uniform400.json

# archives of runs/, which is itself ignored
*.zip

# BigCodeBench task byproducts written into CWD during local execution
split_*
*.db
test_images_*/
mnt/
output/
*.log
df_contents.txt
names.csv
country_population_report.csv
s0.txt
s1.txt
papers/*.pdf

# generated by sphinx from the docstrings; rebuild with `sphinx-build docs docs/_build/html`
docs/_build/
.ipynb_checkpoints/

.DS_Store
.claude/

# Obsidian vault config
.obsidian/

# throwaway analysis scripts; anything worth keeping becomes a notebook cell
scratch/

# superseded artifacts kept for the paired before/after comparison, not for reuse
archived/

# progress notes for a human, not part of the repo
progress_report.md
